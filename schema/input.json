{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transactions",
  "description": "Input root for transaction JSON",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Transaction"
      }
    }
  },
  "required": [
    "assets",
    "transactions"
  ],
  "$defs": {
    "Amount": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/DecimalJson"
        }
      },
      "required": [
        "asset",
        "quantity"
      ]
    },
    "Asset": {
      "type": "object",
      "properties": {
        "asset_class": {
          "$ref": "#/$defs/AssetClass"
        },
        "symbol": {
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "asset_class"
      ]
    },
    "AssetClass": {
      "description": "Asset class for tax treatment",
      "type": "string",
      "enum": [
        "Crypto",
        "Stock",
        "Fiat"
      ]
    },
    "DecimalJson": {
      "description": "Schema shape for decimal fields: written as a numeric string, accepted as\neither a JSON number or a numeric string.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "Fee": {
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/DecimalJson"
        },
        "asset": {
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Price"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asset",
        "amount"
      ]
    },
    "Price": {
      "description": "Price for an asset - either direct GBP or foreign currency with FX conversion\n\nFor direct GBP prices: value_gbp = quantity * rate\nFor FX prices: value_gbp = quantity * rate * fx_rate",
      "type": "object",
      "properties": {
        "base": {
          "description": "The asset this price refers to (e.g., \"BTC\", \"ETH\")",
          "type": "string"
        },
        "fx_rate": {
          "description": "FX rate to convert quote currency to GBP - requires quote",
          "anyOf": [
            {
              "$ref": "#/$defs/DecimalJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "description": "Foreign currency quote (e.g., \"USD\") - requires fx_rate",
          "type": [
            "string",
            "null"
          ]
        },
        "rate": {
          "description": "Price per unit (in GBP, or in quote currency if FX fields present)",
          "$ref": "#/$defs/DecimalJson"
        },
        "source": {
          "description": "Optional source of price data",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "base",
        "rate"
      ]
    },
    "Tag": {
      "description": "Classification tag for a taxable event",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Trade",
            "StakingReward",
            "OtherIncome",
            "Airdrop",
            "AirdropIncome",
            "Dividend",
            "Interest",
            "Gift"
          ]
        },
        {
          "description": "Unclassified event - needs review",
          "type": "string",
          "const": "Unclassified"
        },
        {
          "description": "Employment income, assumed PAYE-settled at source: UK employers must\noperate PAYE on salary paid in readily convertible assets (CRYPTO42050),\nso it is reported but excluded from the income tax estimate",
          "type": "string",
          "const": "Salary"
        },
        {
          "description": "Cashback/reward on personal spending - not taxable income for an\nordinary retail customer (HMRC Statement of Practice 4/97); an\nordinary acquisition establishing market-value cost basis",
          "type": "string",
          "const": "Cashback"
        },
        {
          "description": "No gain/no loss transfer (e.g. spouse/civil partner under s58 TCGA 1992)",
          "type": "string",
          "const": "NoGainNoLoss"
        }
      ]
    },
    "Transaction": {
      "description": "Transaction record with common fields + type-specific data.\n\nSerialization contract: optional fields are omitted when absent (never\n`null`), the default `Unclassified` tag is omitted, and decimal quantities\nare written as numeric strings (`\"0.5\"`) so they stay exact through any\nJSON parser. On input a bare JSON number is also accepted.",
      "type": "object",
      "properties": {
        "account": {
          "description": "Account/wallet where this happened (e.g., \"kraken\", \"ledger\")",
          "type": "string"
        },
        "datetime": {
          "description": "When the transaction occurred (RFC3339 with offset; date-only assumes UTC)",
          "type": "string"
        },
        "description": {
          "description": "Optional description",
          "type": [
            "string",
            "null"
          ]
        },
        "fee": {
          "description": "Optional fee for this transaction",
          "anyOf": [
            {
              "$ref": "#/$defs/Fee"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Unique identifier for this transaction",
          "type": "string"
        },
        "tag": {
          "description": "Optional transaction tag used for classification",
          "$ref": "#/$defs/Tag"
        },
        "valuation": {
          "description": "Optional valuation: a price object or direct GBP total",
          "anyOf": [
            {
              "$ref": "#/$defs/Valuation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "description": "Trade one asset for another (includes fiat and crypto-to-crypto)",
          "type": "object",
          "properties": {
            "bought": {
              "$ref": "#/$defs/Amount"
            },
            "sold": {
              "$ref": "#/$defs/Amount"
            },
            "type": {
              "type": "string",
              "const": "Trade"
            }
          },
          "required": [
            "type",
            "sold",
            "bought"
          ]
        },
        {
          "description": "Deposit - assets received INTO an account",
          "type": "object",
          "properties": {
            "amount": {
              "$ref": "#/$defs/Amount"
            },
            "linked_withdrawal": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "Deposit"
            }
          },
          "required": [
            "type",
            "amount"
          ]
        },
        {
          "description": "Withdrawal - assets sent FROM an account",
          "type": "object",
          "properties": {
            "amount": {
              "$ref": "#/$defs/Amount"
            },
            "linked_deposit": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "Withdrawal"
            }
          },
          "required": [
            "type",
            "amount"
          ]
        }
      ],
      "required": [
        "id",
        "datetime",
        "account"
      ]
    },
    "Valuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Price"
        },
        {
          "$ref": "#/$defs/DecimalJson"
        }
      ]
    }
  }
}
